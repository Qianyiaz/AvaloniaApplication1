<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AvaloniaApplication1.ViewModels"
             xmlns:p1="using:Material.Styles.Assists"
             x:DataType="vm:SettingsPageViewModel"
             x:Class="AvaloniaApplication1.Views.SettingsPage">
    <ScrollViewer>
        <StackPanel Spacing="8">
            <Expander Header="Appearance" IsExpanded="True">
                <ComboBox Margin="15"
                          ToolTip.Tip="Select application theme"
                          ItemsSource="{Binding ThemeOptions}"
                          SelectedValue="{Binding SelectedTheme}"
                          p1:ComboBoxAssist.Label="Current Theme"
                          Theme="{StaticResource MaterialOutlineComboBox}" />
            </Expander>
        </StackPanel>
    </ScrollViewer>
</UserControl>