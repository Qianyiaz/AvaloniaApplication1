<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="using:Material.Styles.Controls"
        xmlns:mia="using:Material.Icons.Avalonia"
        xmlns:vm="using:AvaloniaApplication1.ViewModels"
        xmlns:cvt="using:AvaloniaApplication1.Converters"
        xmlns:views="using:AvaloniaApplication1.Views"
        x:Class="AvaloniaApplication1.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        TransparencyLevelHint="Mica,AcrylicBlur,None"
        Background="Transparent"
        Title="AvaloniaApplication1">

    <Window.Resources>
        <cvt:RadioButtonCheckedConverter x:Key="RadioButtonCheckedConverter" />
    </Window.Resources>

    <Window.Styles>
        <Style Selector="Window">
            <Setter Property="Opacity" Value="0" />
            <Setter Property="RenderTransform" Value="translate(150px,0px) scale(0.85)" />
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Easing="SineEaseOut" Duration="0:0:0.65" />
                    <TransformOperationsTransition Property="RenderTransform" Easing="BackEaseOut" Duration="0:0:0.8" />
                </Transitions>
            </Setter>

            <Style Selector="^[IsVisible=True]">
                <Setter Property="Opacity" Value="1" />
                <Setter Property="RenderTransform" Value="translate(0px,0px) scale(1)" />
            </Style>
        </Style>
    </Window.Styles>

    <Grid Margin="15 10" RowDefinitions="*,Auto">
        <TransitioningContentControl Content="{Binding CurrentPage}">
            <TransitioningContentControl.DataTemplates>
                <DataTemplate DataType="vm:HomePageViewModel">
                    <views:HomePage />
                </DataTemplate>
                <DataTemplate DataType="vm:DownloadPageViewModel">
                    <views:DownloadPage />
                </DataTemplate>
                <DataTemplate DataType="vm:SettingsPageViewModel">
                    <views:SettingsPage />
                </DataTemplate>
            </TransitioningContentControl.DataTemplates>
            <TransitioningContentControl.PageTransition>
                <CompositePageTransition>
                    <PageSlide Duration="0:00:00.4"
                               Orientation="Horizontal"
                               SlideInEasing="CubicEaseOut"
                               SlideOutEasing="CubicEaseIn" />
                    <CrossFade Duration="0:00:00.25"
                               FadeInEasing="SineEaseOut"
                               FadeOutEasing="SineEaseIn" />
                </CompositePageTransition>
            </TransitioningContentControl.PageTransition>
        </TransitioningContentControl>

        <ui:FloatingButton Grid.Row="1"
                           Classes="Accent"
                           ToolTip.Tip="Back"
                           IsEnabled="{Binding IsCanGoBack}"
                           Command="{Binding GoBackCommand}"
                           Content="{mia:MaterialIconExt Kind=ArrowBack,IconSize=24}"
                           HorizontalAlignment="Right" />

        <ui:Card Grid.Row="1"
                 Padding="0"
                 HorizontalAlignment="Left"
                 VerticalAlignment="Center"
                 InsideClipping="True">
            <ui:Card.Styles>
                <Style Selector="RadioButton">
                    <Setter Property="Padding" Value="25 12" />
                    <Setter Property="Theme" Value="{StaticResource MaterialButtonlikeRadioButton}" />
                </Style>

                <Style Selector="mia|MaterialIconText">
                    <Setter Property="IconSize" Value="20" />
                </Style>
            </ui:Card.Styles>
            <StackPanel Orientation="Horizontal">
                <RadioButton Classes="accent"
                             ToolTip.Tip="Home"
                             Content="{mia:MaterialIconTextExt Kind=Home,Text=Home}"
                             IsChecked="{Binding SelectedPageId, Converter={StaticResource RadioButtonCheckedConverter}, ConverterParameter=0}" />

                <RadioButton Classes="accent"
                             ToolTip.Tip="Download"
                             Content="{mia:MaterialIconTextExt Kind=Download,Text=Download}"
                             IsChecked="{Binding SelectedPageId, Converter={StaticResource RadioButtonCheckedConverter}, ConverterParameter=1}" />

                <RadioButton Classes="accent"
                             ToolTip.Tip="Settings"
                             Content="{mia:MaterialIconTextExt Kind=Settings,Text=Settings}"
                             IsChecked="{Binding SelectedPageId, Converter={StaticResource RadioButtonCheckedConverter}, ConverterParameter=2}" />
            </StackPanel>
        </ui:Card>
    </Grid>
</Window>