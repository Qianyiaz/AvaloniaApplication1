<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="using:Material.Styles.Controls"
        xmlns:mia="using:Material.Icons.Avalonia"
        xmlns:vm="using:AvaloniaApplication1.ViewModels"
        xmlns:cvt="using:AvaloniaApplication1.Converters"
        xmlns:views="using:AvaloniaApplication1.Views"
        x:Class="AvaloniaApplication1.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        TransparencyLevelHint="Mica,AcrylicBlur,None"
        Background="Transparent"
        Title="AvaloniaApplication1">

    <Window.Resources>
        <cvt:RadioButtonCheckedConverter x:Key="RadioButtonCheckedConverter" />
    </Window.Resources>

    <Window.Styles>
        <Style Selector="ToggleButton">
            <Setter Property="Padding" Value="21 8" />
            <Setter Property="CornerRadius" Value="35" />

            <Style Selector="^:checked">
                <Setter Property="IsHitTestVisible" Value="False" />
            </Style>
        </Style>

        <Style Selector="Window">
            <Setter Property="Opacity" Value="0" />
            <Setter Property="RenderTransform" Value="translate(150px,0px) scale(0.85)" />
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Easing="SineEaseOut" Duration="0:0:0.65" />
                    <TransformOperationsTransition Property="RenderTransform" Easing="BackEaseOut" Duration="0:0:0.8" />
                </Transitions>
            </Setter>

            <Style Selector="^[IsVisible=True]">
                <Setter Property="Opacity" Value="1" />
                <Setter Property="RenderTransform" Value="translate(0px,0px) scale(1)" />
            </Style>
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="*,Auto">
        <ui:Card Margin="15 15 15 0">
            <ui:Card.Background>
                <LinearGradientBrush Opacity="0.6" StartPoint="0%,0%" EndPoint="100%,0%">
                    <GradientStop Color="#667eea" Offset="0.0" />
                    <GradientStop Color="#764ba2" Offset="1.0" />
                </LinearGradientBrush>
            </ui:Card.Background>
            <Panel>
                <ui:FloatingButton IsEnabled="{Binding Nav.IsCanGoBack}"
                                   Command="{Binding GoBackCommand}"
                                   Content="{mia:MaterialIconExt Kind=ArrowBack}"
                                   HorizontalAlignment="Left"
                                   VerticalAlignment="Top"
                                   FontSize="21"
                                   Padding="5" />

                <TransitioningContentControl Content="{Binding CurrentPage}">
                    <TransitioningContentControl.DataTemplates>
                        <DataTemplate DataType="vm:HomePageViewModel">
                            <views:HomePage />
                        </DataTemplate>
                        <DataTemplate DataType="vm:SettingsPageViewModel">
                            <views:SettingsPage />
                        </DataTemplate>
                    </TransitioningContentControl.DataTemplates>
                    <TransitioningContentControl.PageTransition>
                        <CompositePageTransition>
                            <PageSlide Duration="0:00:00.4"
                                       Orientation="Horizontal"
                                       SlideInEasing="CubicEaseOut"
                                       SlideOutEasing="CubicEaseIn" />
                            <CrossFade Duration="0:00:00.25"
                                       FadeInEasing="SineEaseOut"
                                       FadeOutEasing="SineEaseIn" />
                        </CompositePageTransition>
                    </TransitioningContentControl.PageTransition>
                </TransitioningContentControl>
            </Panel>
        </ui:Card>

        <ui:Card Margin="15" Grid.Row="1">
            <ui:Card.Background>
                <LinearGradientBrush Opacity="0.6" StartPoint="0%,0%" EndPoint="100%,0%">
                    <GradientStop Color="#7c4dff" Offset="0.0" />
                    <GradientStop Color="#2979ff" Offset="1.0" />
                </LinearGradientBrush>
            </ui:Card.Background>
            <Panel>
                <StackPanel Margin="15 0 0 0" VerticalAlignment="Center" Spacing="10" Orientation="Horizontal">
                    <ToggleButton Content="Home"
                                  IsChecked="{Binding Nav.CurrentPageId, Converter={StaticResource RadioButtonCheckedConverter}, ConverterParameter=0}">
                        <Interaction.Behaviors>
                            <ButtonClickEventCommandTrigger
                                Command="{Binding NavigateCommand}"
                                Parameter="0" />
                        </Interaction.Behaviors>
                    </ToggleButton>

                    <ToggleButton Content="Settings"
                                  IsChecked="{Binding Nav.CurrentPageId, Converter={StaticResource RadioButtonCheckedConverter}, ConverterParameter=1}">
                        <Interaction.Behaviors>
                            <ButtonClickEventCommandTrigger
                                Command="{Binding NavigateCommand}"
                                Parameter="1" />
                        </Interaction.Behaviors>
                    </ToggleButton>
                </StackPanel>

                <Button Content="Click Me"
                        Classes="accent"
                        HorizontalAlignment="Right"
                        FontSize="20" Padding="25 14 25 14" CornerRadius="9" />
            </Panel>
        </ui:Card>
    </Grid>
</Window>