<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AvaloniaApplication1.ViewModels"
             xmlns:mia="using:Material.Icons.Avalonia"
             x:Class="AvaloniaApplication1.Views.DownloadPage"
             x:DataType="vm:DownloadPageViewModel">
    <ScrollViewer>
        <StackPanel Spacing="16" Margin="20">
            <Expander Header="Latest Version" IsExpanded="True">
                <ItemsControl ItemsSource="{Binding LatestVersions}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Spacing="8" Margin="8" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                            <RadioButton GroupName="item" 
                                         Padding="15" 
                                         Theme="{StaticResource MaterialButtonlikeRadioButton}"
                                         Content="{mia:MaterialIconTextExt Kind=CubeOutline,Text='{Binding }'}"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Expander>
        </StackPanel>
    </ScrollViewer>
</UserControl>