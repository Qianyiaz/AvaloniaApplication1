<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AvaloniaApplication1.ViewModels"
             xmlns:mia="using:Material.Icons.Avalonia"
             x:Class="AvaloniaApplication1.Views.DownloadPage"
             x:DataType="vm:DownloadPageViewModel">
    <ScrollViewer>
        <StackPanel Spacing="8">
            <Expander Header="Versions" IsExpanded="True">
                <ListBox ItemsSource="{Binding LatestVersions}" SelectedItem="{Binding SelectedVersion}">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                            <mia:MaterialIconText Margin="8"
                                                  IconSize="21"
                                                  Kind="CubeOutline"
                                                  Text="{Binding}"
                                                  ToolTip.Tip="{Binding StringFormat='{}Version: {0}'}" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Expander>
        </StackPanel>
    </ScrollViewer>
</UserControl>