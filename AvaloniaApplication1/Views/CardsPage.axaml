<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="using:Material.Styles.Controls"
             x:Class="AvaloniaApplication1.Views.CardsPage">
    <Grid RowSpacing="8" ColumnSpacing="8" RowDefinitions="*,*" ColumnDefinitions="4*,5*">
        <ui:Card Background="Red" Grid.Row="0" Grid.Column="0" />
        <ui:Card Background="Green" Grid.Row="0" Grid.Column="1" />

        <ui:Card Background="Blue" Grid.Row="1" Grid.Column="0" />
        <ui:Card Background="Yellow" Grid.Row="1" Grid.Column="1" />

        <ProgressBar Theme="{StaticResource MaterialCircularProgressBar}"
                     Grid.RowSpan="2" Grid.ColumnSpan="2"
                     Height="65" Width="{Binding $self.Height}"
                     IsIndeterminate="True" />
    </Grid>
</UserControl>