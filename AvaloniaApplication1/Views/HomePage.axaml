<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="AvaloniaApplication1.HomePage">
    <StackPanel HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="16"
                Margin="30"
                Width="400">
        <TextBlock Text="Welcome HERE BACK!"
                   FontSize="28"
                   FontWeight="Bold"
                   Foreground="{DynamicResource MaterialPrimaryForegroundBrush}" />

        <TextBlock Text="Please Login or Register to continue."
                   FontSize="14"
                   Opacity="0.7"
                   FontWeight="Light" />

        <TextBox PlaceholderText="Username"
                 Classes="outline" />

        <TextBox PlaceholderText="Password"
                 PasswordChar="*"
                 Classes="outline" />

        <Button Content="Login"
                Classes="accent"
                Height="40"
                Margin="0 8 0 0" />

        <HyperlinkButton HorizontalAlignment="Right" Content="Don't have an account? Register Now!" />
    </StackPanel>
</UserControl>